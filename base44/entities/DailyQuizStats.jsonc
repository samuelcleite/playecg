{
  "name": "DailyQuizStats",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "date": {
      "type": "string",
      "format": "date",
      "description": "Data para qual as estatísticas são válidas (YYYY-MM-DD)"
    },
    "failed_cases_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos casos em que o usuário esgotou 3 tentativas sem acertar neste dia"
    }
  },
  "required": [
    "user_email",
    "date"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
