{
  "name": "UserProgress",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "module_id": {
      "type": "string",
      "description": "ID do módulo"
    },
    "phase_id": {
      "type": "string",
      "description": "ID da fase"
    },
    "completed_case_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "IDs dos casos concluídos (acertou pelo menos 1 vez OU tentou 3+ vezes)"
    },
    "completion_count": {
      "type": "number",
      "default": 0,
      "description": "Quantidade de casos concluídos"
    },
    "completion_goal": {
      "type": "number",
      "default": 0,
      "description": "Total de casos da fase (meta para completar)"
    },
    "status": {
      "type": "string",
      "enum": [
        "completed",
        "incomplete"
      ],
      "default": "incomplete",
      "description": "Status da fase: completed quando completion_count >= completion_goal"
    },
    "last_updated": {
      "type": "string",
      "format": "date-time",
      "description": "Última atualização do progresso"
    }
  },
  "required": [
    "user_email",
    "module_id",
    "phase_id",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
