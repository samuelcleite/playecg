{
  // PartnerContact — pessoas de contato de um Partner com kind="institution".
  // Um Partner "person" não tem PartnerContact: ele já é o contato.
  "name": "PartnerContact",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string",
      "description": "Id do Partner (institution) dono deste contato."
    },
    "name": {
      "type": "string",
      "description": "Nome da pessoa de contato."
    },
    "role": {
      "type": "string",
      "description": "Cargo/função dela na instituição (ex: 'Diretor de Marketing')."
    },
    "phone": {
      "type": "string",
      "description": "Telefone/WhatsApp."
    },
    "email": {
      "type": "string",
      "description": "E-mail."
    },
    "instagram": {
      "type": "string",
      "description": "@ do Instagram, sem o @."
    },
    "notes": {
      "type": "string",
      "description": "Observações sobre esta pessoa especificamente."
    },
    "is_primary": {
      "type": "boolean",
      "default": false,
      "description": "Se é o contato principal da instituição, para destacar na lista quando há mais de um."
    }
  },
  "required": ["partner_id", "name"],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
