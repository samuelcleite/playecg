{
  "name": "Account",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "minúsculo, sem espaços — identidade única"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo do usuário"
    },
    "password_hash": {
      "type": "string",
      "description": "PBKDF2 salt:hash, vazio para contas só-Google"
    },
    "google_id": {
      "type": "string",
      "description": "'sub' do Google"
    },
    "apple_id": {
      "type": "string",
      "description": "'sub' do Apple (Sign in with Apple)"
    },
    "avatar_url": {
      "type": "string"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "Papel do usuário no app"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "description": "Tipo de assinatura do usuário"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de início da assinatura premium"
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade médica do usuário"
    },
    "country": {
      "type": "string",
      "description": "País onde o usuário atua"
    },
    "state": {
      "type": "string",
      "description": "Estado onde o usuário atua"
    },
    "city": {
      "type": "string",
      "description": "Cidade onde o usuário atua"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Se o usuário completou o perfil inicial"
    },
    "total_attempts": {
      "type": "number",
      "default": 0,
      "description": "Total de tentativas de quiz"
    },
    "total_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Número de casos distintos já tentados"
    },
    "correct_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas corretas"
    },
    "module_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas em casos de módulo"
    },
    "module_correct_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas corretas em casos de módulo"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Sequência atual de dias praticados"
    },
    "last_practice_date": {
      "type": "string",
      "description": "Última data de prática (YYYY-MM-DD)"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados. 10 por acerto na 1a tentativa do caso, 3 por acerto em revisao. Ver recordQuizAttempt."
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Nivel, derivado dos pontos: 1 + floor(points / 100). Nunca editado a mao."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": false
  }
}
