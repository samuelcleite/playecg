{
  "name": "Account",
  "type": "object",
  "properties": {
    "email": {
      "type": "string",
      "description": "minúsculo, sem espaços — identidade única"
    },
    "full_name": {
      "type": "string",
      "description": "Nome completo do usuário"
    },
    "password_hash": {
      "type": "string",
      "description": "PBKDF2 salt:hash, vazio para contas só-Google"
    },
    "google_id": {
      "type": "string",
      "description": "'sub' do Google"
    },
    "apple_id": {
      "type": "string",
      "description": "'sub' do Apple (Sign in with Apple)"
    },
    "avatar_url": {
      "type": "string"
    },
    "email_verified": {
      "type": "boolean",
      "default": false
    },
    "role": {
      "type": "string",
      "enum": [
        "user",
        "admin"
      ],
      "default": "user",
      "description": "Papel do usuário no app"
    },
    "subscription_type": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "default": "free",
      "description": "Tipo de assinatura do usuário"
    },
    "subscription_start_date": {
      "type": "string",
      "format": "date-time",
      "description": "Data de início da assinatura premium"
    },
    "lifetime_access": {
      "type": "boolean",
      "default": false,
      "description": "Comprou o plano vitalício (pagamento único, Stripe/web). NÃO concede acesso: quem concede é subscription_type. Serve para impedir que os caminhos de expiração rebaixem o comprador para 'free'. Ver INVARIANTE lifetime_access."
    },
    "trial_ends_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do acesso de cortesia. Preenchido = o premium desta conta é cortesia e vence nesta data. Ausente (null) = o premium, se houver, é pago e não vence por este caminho. Como o lifetime_access, ele não concede acesso sozinho: quem concede continua sendo subscription_type. Ver INVARIANTE trial_ends_at."
    },
    "trial_started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Início da cortesia em curso. Existe só para os caminhos de expiração compararem com subscription_start_date: data de assinatura mais recente que esta significa que a pessoa pagou depois de ganhar a cortesia, e então o vencimento do trial não pode rebaixá-la. Sai junto com trial_ends_at."
    },
    "store_expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "Fim do ciclo pago da assinatura de loja (App Store / Google Play), como o RevenueCat informou. Preenchido = o premium desta conta vem da loja e tem data. Ausente (null) = o premium, se houver, vem de outro lugar (Stripe, cortesia, vitalício, concessão manual) e NÃO vence por este caminho. Como o trial_ends_at e o lifetime_access, ele não concede acesso nenhum: quem concede continua sendo subscription_type. A data sozinha também não REBAIXA — ela só autoriza o getMyAccount a perguntar ao RevenueCat, que é quem decide. Ver INVARIANTE store_expires_at."
    },
    "pending_referral_coupon_id": {
      "type": "string",
      "description": "Id do Coupon de parceria que o usuário digitou e que AINDA NÃO virou atribuição. Intenção, não atribuição: quem digita e nunca compra nunca aparece no relatório de nenhum parceiro. O webhook de pagamento promove estes três campos para os referred_by_* e limpa os pendentes."
    },
    "pending_referral_code": {
      "type": "string",
      "description": "O código digitado, aguardando a compra confirmar. Sobrescrito livremente a cada novo código digitado — vale o que estiver aqui no momento do pagamento."
    },
    "pending_referral_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando o código pendente foi digitado. Não existe janela de conversão: pendência não expira. Serve para investigar uma pendência antiga que nunca converteu, e para medir o intervalo entre digitar e assinar."
    },
    "referred_by_coupon_id": {
      "type": "string",
      "description": "Id do Coupon de parceria que trouxe este usuário. É a CHAVE DO RELATÓRIO: a receita por parceiro sai de Payment -> Account -> este campo -> Coupon.partner_name, então o nome do parceiro nunca é copiado para cá e corrigir o nome no cupom corrige o relatório inteiro. Vazio = ninguém indicou."
    },
    "referred_by_code": {
      "type": "string",
      "description": "O código como estava no momento da atribuição (ex: FULANO20). Redundante com o Coupon apontado acima, e de propósito: se o cupom for excluído, o id vira ponteiro morto e só este campo resta para saber o que aconteceu."
    },
    "referred_at": {
      "type": "string",
      "format": "date-time",
      "description": "Quando a atribuição foi gravada. Base para qualquer regra de janela — de conversão ou de comissão — que venha a ser adotada; a regra em si NÃO vive aqui."
    },
    "revenuecat_user_id": {
      "type": "string",
      "description": "App User ID com que o RevenueCat conhece o aparelho desta pessoa, quando ele NÃO é o Account.id. Existe por causa do iOS: o offer code é resgatado fora do app, a assinatura nasce colada num id anônimo ($RCAnonymousID:...), e sem este mapa o revenuecatWebhook não encontra a conta e descarta o evento. O app descobre o valor no getpurchasehistory:// (campo externalUserId) e grava pelo linkRevenueCatUser. Vazio = o aparelho já se identifica com o Account.id, que é o caso do Android e de quem comprou pelo app."
    },
    "specialty": {
      "type": "string",
      "description": "Especialidade médica do usuário"
    },
    "country": {
      "type": "string",
      "description": "País onde o usuário atua"
    },
    "state": {
      "type": "string",
      "description": "Estado onde o usuário atua"
    },
    "city": {
      "type": "string",
      "description": "Cidade onde o usuário atua"
    },
    "profile_completed": {
      "type": "boolean",
      "default": false,
      "description": "Se o usuário completou o perfil inicial"
    },
    "total_attempts": {
      "type": "number",
      "default": 0,
      "description": "Total de tentativas de quiz"
    },
    "total_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Número de casos distintos já tentados"
    },
    "correct_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas corretas"
    },
    "module_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas em casos de módulo"
    },
    "module_correct_first_attempts": {
      "type": "number",
      "default": 0,
      "description": "Primeiras tentativas corretas em casos de módulo"
    },
    "current_streak": {
      "type": "number",
      "default": 0,
      "description": "Sequência atual de dias praticados"
    },
    "last_practice_date": {
      "type": "string",
      "description": "Última data de prática (YYYY-MM-DD)"
    },
    "last_login_at": {
      "type": "string",
      "format": "date-time"
    },
    "points": {
      "type": "number",
      "default": 0,
      "description": "Pontos acumulados. 10 por acerto na 1a tentativa do caso, 3 por acerto em revisao. Ver recordQuizAttempt."
    },
    "level": {
      "type": "number",
      "default": 1,
      "description": "Nivel, derivado dos pontos: 1 + floor(points / 100). Nunca editado a mao."
    }
  },
  "required": [
    "email"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "read": false,
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": false
  }
}
