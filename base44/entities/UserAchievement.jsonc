{
  "name": "UserAchievement",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usuário que conquistou o troféu"
    },
    "achievement_id": {
      "type": "string",
      "description": "ID do troféu (referência à entidade Achievement)"
    },
    "earned_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora em que o troféu foi conquistado"
    }
  },
  "required": [
    "user_email",
    "achievement_id",
    "earned_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
