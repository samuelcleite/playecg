{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "ID do usu\u00e1rio (User.id do Base44) \u2014 substitu\u00eddo por user_email na migra\u00e7\u00e3o para Account; sai do schema na limpeza final"
    },
    "user_email": {
      "type": "string",
      "description": "Email do dono do registro \u2014 alinha esta entidade com todas as outras per-user, que j\u00e1 usam user_email. Ainda n\u00e3o preenchido: backfill e escrita vem na Fase 1.2"
    },
    "endpoint": {
      "type": "string",
      "description": "URL do endpoint de push do navegador"
    },
    "p256dh": {
      "type": "string",
      "description": "Chave p\u00fablica do cliente para encripta\u00e7\u00e3o"
    },
    "auth": {
      "type": "string",
      "description": "Token de autentica\u00e7\u00e3o do cliente"
    }
  },
  "required": [
    "user_id",
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "write": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}