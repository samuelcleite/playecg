{
  "name": "PushSubscription",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do dono do registro — alinha esta entidade com todas as outras per-user, que já usam user_email. Ainda não preenchido: backfill e escrita vem na Fase 1.2"
    },
    "endpoint": {
      "type": "string",
      "description": "URL do endpoint de push do navegador"
    },
    "p256dh": {
      "type": "string",
      "description": "Chave pública do cliente para encriptação"
    },
    "auth": {
      "type": "string",
      "description": "Token de autenticação do cliente"
    }
  },
  "required": [
    "endpoint",
    "p256dh",
    "auth"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
