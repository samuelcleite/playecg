{
  "name": "QuizAttempt",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "case_id": {
      "type": "string",
      "description": "ID do caso"
    },
    "module_id": {
      "type": "string",
      "description": "ID do módulo ao qual o caso pertence"
    },
    "phase_id": {
      "type": "string",
      "description": "ID da fase à qual o caso pertence"
    },
    "user_answer": {
      "type": "string",
      "description": "Resposta do usuário"
    },
    "correct": {
      "type": "boolean",
      "description": "Se acertou ou não"
    },
    "time_spent": {
      "type": "number",
      "description": "Tempo gasto em segundos"
    },
    "quiz_type": {
      "type": "string",
      "enum": [
        "random",
        "module",
        "daily"
      ],
      "description": "Tipo de quiz: random (Quiz Aleatório), module (Módulos), daily (Caso do Dia)"
    },
    "case_source": {
      "type": "string",
      "enum": [
        "current_phase",
        "previous_phase"
      ],
      "description": "Para quiz tipo module: se o caso é da fase atual ou de fases anteriores"
    }
  },
  "required": [
    "user_email",
    "case_id",
    "user_answer",
    "correct"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
