{
  "name": "Payment",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email do usuário"
    },
    "stripe_subscription_id": {
      "type": "string",
      "description": "ID da assinatura no Stripe"
    },
    "reference_id": {
      "type": "string",
      "description": "ID de referência interna"
    },
    "amount": {
      "type": "number",
      "description": "Valor pago mensalmente"
    },
    "discount_amount": {
      "type": "number",
      "description": "Valor do desconto aplicado"
    },
    "coupon_id": {
      "type": "string",
      "description": "ID do cupom usado (se houver)"
    },
    "status": {
      "type": "string",
      "enum": [
        "PENDING",
        "PAID",
        "DECLINED",
        "CANCELED",
        "EXPIRED"
      ],
      "description": "Status do pagamento/assinatura"
    },
    "payment_method": {
      "type": "string",
      "description": "Método de pagamento utilizado"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data do pagamento/autorização"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Última atualização"
    }
  },
  "required": [
    "user_email",
    "reference_id",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
