{
  "name": "CouponUsage",
  "type": "object",
  "properties": {
    "coupon_id": {
      "type": "string",
      "description": "ID do cupom usado"
    },
    "user_email": {
      "type": "string",
      "description": "Email do usuário que usou"
    },
    "original_price": {
      "type": "number",
      "description": "Preço original"
    },
    "discount_applied": {
      "type": "number",
      "description": "Valor do desconto aplicado"
    },
    "final_price": {
      "type": "number",
      "description": "Preço final pago"
    },
    "used_at": {
      "type": "string",
      "format": "date-time",
      "description": "Data e hora do uso"
    }
  },
  "required": [
    "coupon_id",
    "user_email",
    "original_price",
    "discount_applied",
    "final_price"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "create": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "update": {
      "user_condition": {
        "role": "__service_only__"
      }
    },
    "delete": {
      "user_condition": {
        "role": "__service_only__"
      }
    }
  }
}
